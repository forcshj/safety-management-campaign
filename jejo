<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8">
<title>일괄 작성 임베딩 전체 예시</title>
<style>
  html, body { margin: 0; padding: 0; height: 100%; }
  iframe { display: block; width: 100%; height: 100%; border: 0; }
</style>
</head>
<body>

<iframe id="eformsign_iframe" title="이폼사인 일괄 작성"></iframe>

<script>
/* ================================================================
   일괄 작성 임베딩 호스트 스크립트
   페이지에 한 번만 포함하면 됩니다. 별도로 설치할 파일은 없습니다.
   ================================================================ */
function EformSignBulkDocument() {
  this._domain = 'https://www.eformsign.com';
  this._viewer = '/eform/form/bulk_create.html';
  this._mode = 'EMBEDDING_BULKDOCUMENT';
  this._iframe = null; this._option = null;
  this._success = null; this._error = null; this._action = null;
  this._validationCallback = null;
  var self = this;
  window.addEventListener('message', function (e) {
    var data = e.data;
    if (typeof data === 'string') { try { data = JSON.parse(data); } catch (err) { return; } }
    if (!data || typeof data !== 'object' || !data.fn) return;
    if (self._iframe && e.source !== self._iframe.contentWindow) return;
    switch (data.fn) {
      case 'isEmbeddingBulkDocument': self._sendInit(); break;
      case 'saveSuccess': if (self._success) self._success(data); break;
      case 'errorMessage': if (self._error) self._error({ code: data.code, message: data.message }); break;
      case 'actionCallback': if (self._action) self._action(data); break;
      case 'setStorage':
        if (data.message && self._option && self._option.user) {
          self._option.user.access_token = data.message.access_token;
          self._option.user.refresh_token = data.message.refresh_token;
        }
        break;
      case 'checkValidation':
        if (self._validationCallback) { self._validationCallback(data); self._validationCallback = null; }
        break;
    }
  }, false);
}
EformSignBulkDocument.prototype._post = function (obj) {
  if (this._iframe && this._iframe.contentWindow) {
    this._iframe.contentWindow.postMessage(JSON.stringify(obj), this._domain);
  }
};
EformSignBulkDocument.prototype._sendInit = function () {
  var o = this._option, u = o.user || {};
  var msg = {
    mode: this._mode,
    company_id: o.company.id,
    country_code: o.company.country_code || '',
    _id: u.id || '',
    access_token: u.access_token || '',
    refresh_token: u.refresh_token || '',
    outside_key: o.company.user_key || '',
    action_callback: !!this._action,
    hide_title: !!(o.layout && o.layout.hide_title),
    hide_data_select: !!(o.layout && o.layout.hide_data_select),
    hide_request_popup: !!(o.layout && o.layout.hide_request_popup),
    data_entry: (o.layout && o.layout.data_entry) || ''
  };
  if (o.max_document_count) msg.max_document_count = o.max_document_count;
  if (o.max_document_count_excel) msg.max_document_count_excel = o.max_document_count_excel;
  this._post({ type: 'document', fn: 'isEmbeddingBulkDocument', message: msg });
};
EformSignBulkDocument.prototype.bulkDocument = function (option, iframe_id, success, error, action) {
  this._option = option; this._success = success; this._error = error; this._action = action;
  this._iframe = document.getElementById(iframe_id);
  this._template_id = option.mode.template_id;
  this._layout = option.layout || {};
};
EformSignBulkDocument.prototype.open = function () {
  var l = this._layout;
  var url = this._domain + this._viewer + '?form_id=' + encodeURIComponent(this._template_id)
    + '&openmode=' + this._mode + '&lang_code=' + encodeURIComponent(l.lang_code || 'ko');
  if (l.header === false) url += '&header=false';
  if (l.footer === false) url += '&footer=false';
  this._iframe.src = url;
};
EformSignBulkDocument.prototype.sendAction = function (action) {
  this._post({ type: 'document', fn: 'sendAction', message: { action: action } });
};
EformSignBulkDocument.prototype.changeDataEntry = function (type) {
  this._post({ type: 'document', fn: 'changeDataEntry', message: type });
};
EformSignBulkDocument.prototype.setRequestInfo = function (info) {
  this._post({ type: 'document', fn: 'prefillRequestInfo', message: info });
};
EformSignBulkDocument.prototype.checkValidation = function (check, callback) {
  this._validationCallback = callback || null;
  this._post({ type: 'document', fn: 'checkValidation', message: check });
};
</script>

<script>
/* ================================================================
   호출은 아래 3단계가 전부입니다.
   ================================================================ */

// 1) 객체 생성 (페이지에 한 번)
var eformsign = new EformSignBulkDocument();

// 2) 옵션과 콜백 등록
//    아래 YOUR_ 로 시작하는 값들을 실제 값으로 바꾸세요.
//    access_token과 refresh_token은 서버에서 발급받은 토큰입니다.
eformsign.bulkDocument({
  company: { id: 'ebdc0d5260994120ba4caaa6b085aac4', country_code: 'kr' },
  mode: { template_id: 'a17c6dc225ba4ae88a29a7564e3f3800' },
  user: {
    type: '01',
    id: 'baegjh@forcs.com',
    access_token: '6cb920e4-6e83-4ec9-be41-1fcd0f015bc3',
    refresh_token: '3041020100301306072a8648ce3d020106082a8648ce3d030107042730250201010420b189bb4d9d1626a80bb97ed5f6c05e77173812ff6cbc2d69dd8d0ff4b66c95cf'
  },
  layout: { lang_code: 'ko', header: true, footer: true }
}, 'eformsign_iframe',
  function (res) { console.log('전송 완료', res.bulk_creation_id, res.success_results, res.fail_results); },
  function (err) { console.log('오류', err.code, err.message); },
  function (res) { console.log('버튼 목록', res.data); });

// 3) 열기 - iframe에 일괄 작성 화면이 로드됩니다
eformsign.open();
</script>

</body>
</html>
